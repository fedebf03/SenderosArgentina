rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aislar los datos privados de cada usuario autenticado
    match /usuarios/{idUsuario}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == idUsuario;
    }
    // Catálogo público: lo lee cualquier usuario autenticado y solo su autor lo crea, edita o borra
    match /senderosPublicos/{idSendero} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.idAutor == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.idAutor == request.auth.uid
        && request.resource.data.idAutor == request.auth.uid;
      allow delete: if request.auth != null && resource.data.idAutor == request.auth.uid;
    }
    // Denegar por defecto cualquier otra ruta
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
